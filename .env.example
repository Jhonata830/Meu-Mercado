# Meu Mercado - configuração local
# Copie este arquivo para .env e preencha os valores.

# Gere uma chave aleatória longa para a sessão do Flask.
SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria

# Opcional: integração com Bluesoft Cosmos
COSMOS_API_TOKEN=
COSMOS_USER_AGENT=

# No seu ZimaOS, aponte para o HDD de backups:
# BACKUP_HOST_PATH=/path/to/your/backup
#
# Em outro computador, pode deixar vazio e usar a pasta ./backups:
BACKUP_HOST_PATH=./backups
